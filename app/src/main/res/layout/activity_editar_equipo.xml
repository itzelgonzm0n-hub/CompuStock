<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar equipo"
            android:textColor="#173B65"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el equipo que deseas modificar"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spEquipos"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>

        <EditText
            android:id="@+id/etNombreEditar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nombre del equipo"
            android:inputType="textCapSentences"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spTipoEditar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etMarcaEditar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Marca"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etSerieEditar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Número de serie"
            android:inputType="text"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnGuardarEdicion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:backgroundTint="#1769AA"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Volver"
            android:textAllCaps="false"
            android:backgroundTint="#64748B"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>