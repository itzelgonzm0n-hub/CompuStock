<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CompuStock"
            android:textColor="#173B65"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¡Bienvenido!"
            android:textColor="#173B65"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="Sistema de control de inventario de equipos de cómputo"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MENÚ PRINCIPAL"
            android:textColor="#173B65"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnRegistrarEquipo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Registrar equipo"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1769AA"/>

        <Button
            android:id="@+id/btnInventario"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="Consultar inventario"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1769AA"/>

        <Button
            android:id="@+id/btnReportes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="Reportes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1769AA"/>

        <Button
            android:id="@+id/btnAdministracion"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="Administración"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1769AA"/>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#B42318"/>

    </LinearLayout>

</ScrollView>